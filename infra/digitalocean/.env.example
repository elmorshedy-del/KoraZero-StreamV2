# KoraZero Stream V2 — DigitalOcean
# Copy to .env on the VPS. Never commit the real .env.

# Authorized IPTV provider account
V2_IPTV_PORTAL_URL=https://YOUR_PROVIDER_HOST
V2_IPTV_USERNAME=CHANGE_ME
V2_IPTV_PASSWORD=CHANGE_ME

# Let authenticated V2 Remote select verified numeric provider stream IDs.
V2_IPTV_CATALOG_MODE=true

# Preserve the provider account's one-active-media-session limit.
V2_IPTV_MAX_ACTIVE_PULLS=1

# Static channels are not required for the current dynamic operator remote.
V2_CHANNELS_JSON={}

# Generate long random values on the VPS.
V2_INTERNAL_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN
V2_OPERATOR_PIN=CHANGE_ME_OPERATOR_PIN

# Fresh MistServer bootstrap credentials.
V2_MIST_USERNAME=v2control
V2_MIST_PASSWORD=CHANGE_ME_LONG_RANDOM_MIST_PASSWORD
V2_MIST_BOOTSTRAP_ACCOUNT=true

# These are also forced by docker-compose.yml, kept here for clarity.
V2_PUBLIC_HLS_BASE=https://mist-v2.korazero.com/hls
V2_MIST_API_ENDPOINT=http://mistserver:4242/api2
V2_IPTV_RELAY_BASE=http://v2-iptv-relay.railway.internal:8080

# Keep automation off for the first cutover. Turn it on only after manual playback passes.
V2_AUTO_SCHEDULE=false

# Optional diagnostics; leave blank during the initial cutover.
V2_SMOKE_TEST_CHANNEL=
V2_IPTV_AUDIO_DELAY_MS_BY_STREAM={}
